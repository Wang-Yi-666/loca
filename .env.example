# Copy to .env and fill in the keys you have. Never commit .env itself.
# 复制成 .env，把你手上的 key 填进去。注意 .env 本身不要提交。

# Which provider to use when none is passed explicitly.
# 没有显式指定 provider 时用哪个。可选：deepseek | openai | anthropic
LOCA_DEFAULT_PROVIDER=deepseek

# DeepSeek — the only fully implemented provider today.
# DeepSeek —— 目前唯一完整实现的 provider。去 https://platform.deepseek.com/ 申请 key。
LOCA_DEEPSEEK_API_KEY=

# OpenAI — stub, raises NotImplementedError until Week 5.
# OpenAI —— 占位实现，Week 5 之前调用会抛 NotImplementedError。
LOCA_OPENAI_API_KEY=

# Anthropic — stub, raises NotImplementedError until Week 5.
# Anthropic —— 占位实现，Week 5 之前调用会抛 NotImplementedError。
LOCA_ANTHROPIC_API_KEY=
