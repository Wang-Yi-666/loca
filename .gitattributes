# Normalize line endings so Windows checkouts don't produce
# whole-file diffs on every edit.
* text=auto eol=lf

# Binary assets — never touch these
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Keep Windows-only scripts CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Give linguist something to work with on GitHub
*.py    text diff=python
*.md    text
*.html  text
*.toml  text
*.json  text
